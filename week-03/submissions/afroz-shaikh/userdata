#!/bin/bash
set -e

# Update packages and install nginx
dnf update -y
dnf install -y nginx

# Enable and start nginx
systemctl enable nginx
systemctl start nginx

# Verify status (logs to /var/log/user-data.log for troubleshooting)
systemctl is-enabled nginx >> /var/log/user-data.log 2>&1
systemctl is-active nginx >> /var/log/user-data.log 2>&1

# Create custom index page
cat > /usr/share/nginx/html/index.html << 'EOF'
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CloudAdhar x TrainWithShubham</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #0f172a;
            color: #f1f5f9;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        .card {
            background-color: #1e293b;
            padding: 40px 60px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.4);
            text-align: center;
        }
        h1 {
            color: #38bdf8;
            margin-bottom: 5px;
        }
        h2 {
            font-weight: normal;
            color: #94a3b8;
            margin-top: 0;
        }
        p {
            margin: 10px 0;
            font-size: 18px;
        }
        .label {
            color: #38bdf8;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="card">
        <h1>Afroz Shaikh</h1>
        <h2>AWS Zero To Hero - CloudAdhar x TrainWithShubham</h2>
        <p><span class="label">Sessions:</span> Jul 18-19, 2026</p>
        <p><span class="label">Course sessions:</span> Day 5-6</p>
        <p><span class="label">Exam focus:</span> SAA-C03 Domains 1-4</p>
        <p><span class="label">Main pillars:</span> Security and Reliability</p>
    </div>
</body>
</html>
EOF

# Restart nginx to ensure it picks up the new page
systemctl restart nginx